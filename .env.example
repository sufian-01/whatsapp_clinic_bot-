CLINIC_NAME=XYZ Clinic
CLINIC_SUPPORT_PHONE=6200126662
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_SHEET_ID=
CLINIC_SHEET_RANGE=doctor!A1:Z1000
PATIENT_SHEET_RANGE=patient!A1:Z1000
APPOINTMENT_SLOT_SHEET_RANGE=appointment_slots!A1:Z5000
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TELEGRAM_WEBHOOK_URL=https://your-public-host.example.com

# Optional Sarvam AI voice features. Text chat works when these are left blank.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
# Optional safety limits for Telegram voice messages.
SARVAM_REQUEST_TIMEOUT_SECONDS=20
SARVAM_MAX_VOICE_BYTES=10485760
SARVAM_MAX_VOICE_DURATION_SECONDS=30
