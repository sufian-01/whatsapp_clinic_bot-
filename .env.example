CLINIC_NAME=XYZ Clinic
CLINIC_SUPPORT_PHONE=6200126662
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_SHEET_ID=
CLINIC_SHEET_RANGE=doctor!A1:Z1000
PATIENT_SHEET_RANGE=patient!A1:Z1000
APPOINTMENT_SLOT_SHEET_RANGE=appointment_slots!A1:Z5000
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TELEGRAM_WEBHOOK_URL=https://your-public-host.example.com

# Optional Sarvam AI voice features. Text chat works when these are left blank.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
# Optional safety limits for Telegram voice messages.
SARVAM_REQUEST_TIMEOUT_SECONDS=20
SARVAM_MAX_VOICE_BYTES=10485760
SARVAM_MAX_VOICE_DURATION_SECONDS=30

# ==============================
# Payment Settings (Phase 1A)
# ==============================
CLINIC_UPI_ID=

# ==============================
# Environment & Security (Phase 1A)
# ==============================
APP_ENV=development
ALLOW_DEMO_PASSWORD=false
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=admin123
CRM_ADMIN_PASSWORD_HASH=
CRM_SECRET_KEY=clinic-crm-secret-key-change-in-production
CRM_TOKEN_EXPIRE_HOURS=24

# ==============================
# Database (PostgreSQL Foundation - Phase 1B)
# ==============================
DATABASE_URL=postgresql://clinic_user:clinic_password@localhost:5432/clinic_crm

# ==============================
# Platform & Super Admin (Phase 1E)
# ==============================
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD_HASH=

# ==============================
# Meta WhatsApp Cloud API Channel
# ==============================
WHATSAPP_ENABLED=false
# Meta Graph API Version (e.g. v21.0, v22.0)
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_API_VERSION=v21.0
# Meta Cloud API Credentials from Meta App Dashboard
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_URL=https://your-public-host.example.com/webhook/whatsapp
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Multi-tenant phone mapping JSON: {"<phone_number_id>": "<tenant_id>"}
WHATSAPP_TENANT_PHONE_MAP={}
# Optional default clinic tenant ID for test number (e.g. during single-tenant test setup)
WHATSAPP_DEFAULT_CLINIC_ID=
# Test recipient phone number for Meta connectivity testing (authorized in Meta dashboard)
WHATSAPP_TEST_RECIPIENT_PHONE=
# Configurable Meta test template (e.g. jaspers_market_order_confirmation_v1)
WHATSAPP_TEST_TEMPLATE_NAME=jaspers_market_order_confirmation_v1
WHATSAPP_TEST_TEMPLATE_LANGUAGE=en_US

